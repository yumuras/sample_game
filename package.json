{
  "name": "senbon-torii",
  "productName": "千本鳥居の向こう側",
  "version": "0.1.0",
  "description": "短編ループノベル『千本鳥居の向こう側』",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "tsc",
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder",
    "dist:win": "tsc && electron-builder --win",
    "dist:mac": "tsc && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "io.github.yumuras.senbontorii",
    "productName": "千本鳥居の向こう側",
    "directories": { "output": "release" },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "images/**/*",
      "audio/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": { "target": "dir" },
    "mac": { "target": "dir" },
    "linux": { "target": "dir" }
  }
}
