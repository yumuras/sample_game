{
  "name": "senbon-torii",
  "productName": "千本鳥居の向こう側",
  "version": "0.1.0",
  "description": "短編ループノベル『千本鳥居の向こう側』",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:app": "tsc -p tsconfig.electron.json && node scripts/dev-electron.mjs",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "typecheck": "tsc && tsc -p tsconfig.electron.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "io.github.yumuras.senbontorii",
    "productName": "千本鳥居の向こう側",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    }
  }
}
